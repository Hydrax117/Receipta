# =============================================================================
# Receipta — Top-level Environment Variable Reference
# =============================================================================
# Each sub-project has its own .env.example with full details:
#
#   backend/.env.example   — Express API server variables
#
# Quick-start: copy backend/.env.example to backend/.env and fill in values.
# =============================================================================

# --- Backend (see backend/.env.example for full reference) ---
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
CONTRACT_ID=
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Frontend ---
# NEXT_PUBLIC_API_URL points to the backend Express server.
NEXT_PUBLIC_API_URL=http://localhost:3001
