# =============================================================================
# frontend/.env.local.example
# =============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# .env.local is never committed to version control.
#
# Next.js exposes variables prefixed with NEXT_PUBLIC_ to the browser bundle.
# Any change requires a full rebuild (next build) to take effect.
# =============================================================================

# URL of the Receipta backend API server.
# Development:  http://localhost:3001
# Staging:      https://api-staging.receipta.app
# Production:   https://api.receipta.app
#
# REQUIRED in production — the build will fail if this is not set.
NEXT_PUBLIC_API_URL=http://localhost:3001
